# =============================================================================
# dailyNewsDigest2 - .env.example
# -----------------------------------------------------------------------------
# 目的（Why）: 本アプリの環境変数の雛形を共有し、APIキー等の設定漏れを防ぐ。
# 使い方（How）: このファイルを `.env` に複製し、値を実際のものに置き換える。
# 注意（Caution）:
#   - `.env` は絶対に Git へコミットしない（.gitignore で除外済み）。
#   - 実際のAPIキーをこのファイルに書かない（ダミー値のみ）。
#   - Gemini は請求先未設定の Free Tier プロジェクトのみを使用すること。
# 変更履歴（Change Log）:
#   2026-11-02 - 初版作成（Step 1-1）
# =============================================================================

# --- アプリケーション ---
APP_NAME=dailyNewsDigest2
APP_ENV=local
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- データベース（PostgreSQL） ---
POSTGRES_USER=digest
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=digest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://digest:change_me_local_only@localhost:5432/digest

# --- タイムゾーン ---
APP_TIMEZONE=Asia/Tokyo
SCHEDULER_HOUR=7
SCHEDULER_MINUTE=0

# --- Gemini API（Google AI Studio / Free Tier のみ） ---
GEMINI_API_KEY=
GEMINI_ENABLED=false
GEMINI_FREE_TIER_CONFIRMED=false

# --- OpenRouter API（無料モデルのみ） ---
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LLM 安全制御 ---
# 有料モデル実行はコードレベルで禁止（この値では解除できない）
LLM_ENABLED=false
LLM_AUTO_SWITCH=true
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_DAILY_CALL_LIMIT=200

# --- RSS 取得 ---
RSS_FETCH_TIMEOUT_SECONDS=15
RSS_USER_AGENT=dailyNewsDigest2/1.0
RSS_SUMMARY_CHAR_LIMIT=200
RSS_ALLOWED_SCHEMES=http,https

# --- 表示 ---
DEFAULT_DISPLAY_COUNT=15
MAX_DISPLAY_COUNT=15
