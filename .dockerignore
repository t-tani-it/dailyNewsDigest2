# =============================================================================
# dailyNewsDigest2 - .dockerignore
# -----------------------------------------------------------------------------
# 目的（Why）: ビルドコンテキストから機密情報・不要物を除外し、
#              イメージへの混入とビルド時間増大を防ぐ。
# 変更履歴（Change Log）:
#   2026-11-02 - 初版作成（Step 1-2）
# =============================================================================

.venv/
venv/
.env
.env.*
!.env.example
.git/
.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
tests/
docs/
reports/
*.log
*.db
*.sqlite3
